name: Publish verified local release
on:
  workflow_dispatch:
    inputs:
      manifest_sha256:
        description: SHA256 of the locally verified publication manifest
        required: true
        type: string
permissions:
  contents: write
concurrency:
  group: verified-v041-publication
  cancel-in-progress: false
jobs:
  transfer:
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    env:
      GH_TOKEN: ${{ github.token }}
      MANIFEST_SHA256: ${{ inputs.manifest_sha256 }}
    steps:
      - name: Load worker from this immutable workflow commit
        shell: bash
        run: |
          gh api "repos/$GITHUB_REPOSITORY/contents/tools/publication-worker.py?ref=$GITHUB_SHA" --jq .content | base64 --decode > "$RUNNER_TEMP/publication-worker.py"
      - name: Verify transfer, import exact Git refs and publish existing ZIP
        run: python "$RUNNER_TEMP/publication-worker.py"
