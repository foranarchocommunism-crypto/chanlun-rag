{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chan-kg:curation:1.1.0",
  "type": "object",
  "required": [
    "id",
    "text",
    "kind",
    "conditions",
    "exceptions",
    "concepts",
    "review_note",
    "evidence",
    "importance_level",
    "importance_reason",
    "reviewer"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "explicit",
        "inferred"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "ambiguity_status": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "const": "GPT-6.1 Sol xhigh / source curation"
      }
    },
    "importance_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "importance_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "figure_review_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "enum": [
              "composed_of",
              "defines",
              "distinguishes",
              "illustrates",
              "qualifies",
              "related",
              "requires"
            ]
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "properties": {
        "supporting_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "inferred"
          }
        }
      },
      "then": {
        "required": [
          "derivation"
        ],
        "properties": {
          "derivation": {
            "required": [
              "supporting_claim_ids",
              "explanation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "contains": {
              "required": [
                "figure_ids"
              ],
              "properties": {
                "figure_ids": {
                  "minItems": 1
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "figure_review_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "explicit"
          }
        }
      },
      "then": {
        "properties": {
          "derivation": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "passage_id",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "passage_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "quote_start": {
          "type": "integer",
          "minimum": 0
        },
        "figure_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
