{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chan-kg/evidence-packet/1",
  "type": "object",
  "required": ["contract_version", "request_id", "schema_version", "graph_version", "index_version", "policy_version", "data", "runtime"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "request_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "graph_version": { "type": "string" },
    "index_version": { "type": ["string", "null"] },
    "policy_version": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["query", "mode", "status", "reviewed", "research_leads", "source_context", "issues", "relation_paths", "deferred", "budget"],
      "properties": {
        "mode": { "enum": ["knowledge", "research", "source"] },
        "reviewed": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "research_leads": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "source_context": { "type": "array" },
        "issues": { "type": "array" },
        "relation_paths": { "type": "array", "items": { "$ref": "#/$defs/graph_path" } },
        "deferred": { "type": "array" },
        "budget": { "type": "object" }
      }
    },
    "runtime": { "type": "object", "required": ["requested_profile", "actual_channels", "degraded", "elapsed_ms", "stages"] }
  },
  "$defs": {
    "graph_step": {
      "type": "object",
      "required": ["relation_id", "relation_type", "source", "target", "traversal_direction", "support_claim_id", "support_evidence_ids"],
      "properties": {
        "relation_id": { "type": "string" },
        "relation_type": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "traversal_direction": { "enum": ["source_to_target", "target_to_source_association_only"] },
        "support_claim_id": { "type": "string" },
        "support_evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "graph_path": {
      "type": "object",
      "required": ["relation_id", "depth", "relation_path", "concept_path", "semantics"],
      "properties": {
        "depth": { "type": "integer", "minimum": 1, "maximum": 2 },
        "relation_path": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string" } },
        "concept_path": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string" } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/graph_step" } },
        "auxiliary_claims": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/claim" } },
        "evidence_chain_complete": { "type": "boolean" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "conditions", "exceptions", "kind", "review_status", "ambiguity_status", "review_note", "evidence", "retrieval"],
      "properties": {
        "id": { "type": "string" },
        "conditions": { "type": "array" },
        "exceptions": { "type": "array" },
        "review_status": { "enum": ["reviewed", "pending"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "claim_id", "passage_id", "quote", "quote_start", "quote_end", "source_spans", "role", "speaker", "filename", "pdf_page", "review_status", "context_semantic_review"],
      "properties": { "context_semantic_review": { "const": "not_asserted" } }
    }
  }
}
