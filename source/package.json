{
  "name": "@chan-kg/agent",
  "version": "0.4.2",
  "description": "Evidence-preserving local access to the Chan source knowledge graph",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "chan-kg": "./bin/chan-kg.mjs",
    "chan-kg-mcp": "./bin/chan-kg-mcp.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "export": "node scripts/export.mjs",
    "package": "node scripts/package-portable.mjs",
    "index:build": "node scripts/build-index.mjs",
    "index:vectors": "node scripts/build-vectors.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./retrieval": "./src/retrieval.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
